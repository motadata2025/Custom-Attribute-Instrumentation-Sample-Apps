{
    "name": "oteltracer/user-management-tracer",
    "description": "User Management CRUD API with OpenTelemetry Manual Tracing and Custom Spans",
    "type": "project",
    "keywords": ["opentelemetry", "api", "crud", "user-management", "manual-tracing", "custom-spans"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-pdo": "*",
        "ext-pgsql": "*",
        "open-telemetry/exporter-otlp": "^1.3",
        "open-telemetry/opentelemetry-auto-cakephp": "^0.0.6",
        "open-telemetry/opentelemetry-auto-codeigniter": "^0.1.0",
        "open-telemetry/opentelemetry-auto-curl": "^0.1.0",
        "open-telemetry/opentelemetry-auto-doctrine": "^0.3.1",
        "open-telemetry/opentelemetry-auto-ext-amqp": "^0.0.6",
        "open-telemetry/opentelemetry-auto-ext-rdkafka": "^0.0.3",
        "open-telemetry/opentelemetry-auto-guzzle": "^1.2",
        "open-telemetry/opentelemetry-auto-http-async": "^1.1",
        "open-telemetry/opentelemetry-auto-io": "^0.1.0",
        "open-telemetry/opentelemetry-auto-laravel": "^1.4",
        "open-telemetry/opentelemetry-auto-mongodb": "^0.2.0",
        "open-telemetry/opentelemetry-auto-mysqli": "^0.1.0",
        "open-telemetry/opentelemetry-auto-openai-php": "^0.1.0",
        "open-telemetry/opentelemetry-auto-pdo": "^0.3.0",
        "open-telemetry/opentelemetry-auto-psr15": "^1.1",
        "open-telemetry/opentelemetry-auto-psr16": "^0.0.5",
        "open-telemetry/opentelemetry-auto-psr18": "^1.1",
        "open-telemetry/opentelemetry-auto-slim": "^1.3",
        "open-telemetry/opentelemetry-auto-symfony": "^1.1",
        "open-telemetry/opentelemetry-auto-wordpress": "^0.1.1",
        "open-telemetry/opentelemetry-auto-yii": "^0.2.0",
        "open-telemetry/sdk": "^1.10",
        "php-http/guzzle7-adapter": "^1.1",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "vlucas/phpdotenv": "^5.5",
        "yidas/yii2-bower-asset": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8082 public/index.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true,
            "yiisoft/yii2-composer": true,
            "tbachert.spi": true,
            "php-http.discovery": false
        }
    }
}
